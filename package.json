    "vue-router": "^3.5.1",
    "vuex": "^3.6.2",
    "vuex-persistedstate": "^4.1.0",
    "webpack-dev-server": "^5.1.0",
    "websocket": "^1.0.35"
  },
  "devDependencies": {
